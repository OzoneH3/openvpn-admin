# Copy to .env and fill in.
# .env is git-ignored.

# JWT signing key. 32+ random bytes.
#   openssl rand -hex 32
JWT_SECRET=
# Alternatively mount a secret file and set:
# JWT_SECRET_FILE=/run/secrets/openvpn_admin_jwt

# Dashboard admin credentials.
ADMIN_USER=admin
#   openssl rand -hex 16
ADMIN_PASSWORD=
# Alternatively mount a secret file and set:
# ADMIN_PASSWORD_FILE=/run/secrets/openvpn_admin_password

# Optional: encrypted CA support for non-interactive create/revoke operations.
# Store only the passphrase in this root-readable file (chmod 600).
# CA_PASSWORD_FILE=/run/secrets/openvpn_ca_password

# Optional client-profile source files. Defaults are under OPENVPN_PATH.
# CLIENT_TEMPLATE_PATH=/etc/openvpn/client-template.txt
# TLS_CRYPT_KEY_PATH=/etc/openvpn/tls-crypt.key
# TLS_AUTH_KEY_PATH=/etc/openvpn/tls-auth.key

# Optional: report OpenVPN server health from its local listening socket
# instead of relying on a specific systemd unit name. Supports udp or tcp.
# OPENVPN_LISTEN_PORT=1194
# OPENVPN_LISTEN_PROTO=udp
