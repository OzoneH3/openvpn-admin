[Unit]
Description=OpenVPN Management Service
After=network.target openvpn-server@server.service
Wants=openvpn-server@server.service

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/apps/openvpn-mgmt
ExecStart=/mnt/apps/openvpn-mgmt/openvpn-mgmt serve
Restart=always
RestartSec=10
Environment=DB_PATH=/mnt/apps/openvpn-mgmt/data/openvpn.db
Environment=EASYRSA_PATH=/mnt/scripts/openvpn/ca_dir
Environment=OPENVPN_PATH=/etc/openvpn
Environment=CLIENTS_DIR=/etc/openvpn/clients
Environment=JWT_SECRET_FILE=/mnt/apps/openvpn-mgmt/.jwt_secret
Environment=ADMIN_PASSWORD_FILE=/mnt/apps/openvpn-mgmt/.admin_password
Environment=ADMIN_USER=admin

# Optional: use the actual OpenVPN listener for dashboard server status.
# Set these to match the OpenVPN server config, e.g. port 1194 / proto udp.
# Environment=OPENVPN_LISTEN_PORT=1194
# Environment=OPENVPN_LISTEN_PROTO=udp

# Security
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/mnt/apps/openvpn-mgmt/data -/etc/openvpn/clients /mnt/scripts/openvpn/ca_dir/pki

[Install]
WantedBy=multi-user.target
